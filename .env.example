# AIMS ERP Environment Configuration

# Application environment
#
# development = SQLite fallback allowed
# production  = PostgreSQL DATABASE_URL required
# test        = SQLite fallback allowed
APP_ENV=development

# Leave DATABASE_URL unset/empty to use the default persistent SQLite database:
# database/aims.db
#
# For production PostgreSQL, replace this with the production connection URL.
DATABASE_URL=

# IMPORTANT: Replace this in production with a long random secret.
SECRET_KEY=change_this_secret_key
